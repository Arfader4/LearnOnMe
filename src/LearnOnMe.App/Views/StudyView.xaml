<UserControl x:Class="LearnOnMe.App.Views.StudyView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:views="clr-namespace:LearnOnMe.App.Views"
             xmlns:wv2="clr-namespace:Microsoft.Web.WebView2.Wpf;assembly=Microsoft.Web.WebView2.Wpf">
    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVisibility" />
        <CollectionViewSource x:Key="FilesView" Source="{Binding Files}">
            <CollectionViewSource.GroupDescriptions>
                <PropertyGroupDescription PropertyName="Group" />
            </CollectionViewSource.GroupDescriptions>
        </CollectionViewSource>
    </UserControl.Resources>

    <Grid>
        <!-- Empty state: no HTML files in this subject's pins yet. -->
        <StackPanel Margin="0,24,0,0" HorizontalAlignment="Left" MaxWidth="560">
            <StackPanel.Style>
                <Style TargetType="StackPanel">
                    <Setter Property="Visibility" Value="Collapsed" />
                    <Style.Triggers>
                        <MultiDataTrigger>
                            <MultiDataTrigger.Conditions>
                                <Condition Binding="{Binding HasFiles}" Value="False" />
                                <Condition Binding="{Binding IsLoading}" Value="False" />
                            </MultiDataTrigger.Conditions>
                            <Setter Property="Visibility" Value="Visible" />
                        </MultiDataTrigger>
                    </Style.Triggers>
                </Style>
            </StackPanel.Style>
            <TextBlock Text="Tu otworzysz swoje quizy i fiszki" FontSize="18" FontWeight="SemiBold" />
            <TextBlock Margin="0,6,0,20" Style="{StaticResource SecondaryText}" TextWrapping="Wrap"
                       Text="Wrzuć pliki .html do przypiętego folderu albo przypnij sam plik HTML. LearnOnMe znajdzie je tutaj, a wyniki zapisane przez quiz w localStorage zostaną między uruchomieniami." />
            <StackPanel Orientation="Horizontal">
                <Button Style="{StaticResource SecondaryButton}" Command="{Binding AddFileCommand}" Margin="0,0,8,0">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="&#xE8A5;" Style="{StaticResource IconText}" FontSize="14" Margin="0,0,8,0" />
                        <TextBlock Text="Przypnij plik HTML" />
                    </StackPanel>
                </Button>
                <Button Style="{StaticResource SecondaryButton}" Command="{Binding RefreshCommand}">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="&#xE72C;" Style="{StaticResource IconText}" FontSize="14" Margin="0,0,8,0" />
                        <TextBlock Text="Szukaj ponownie" />
                    </StackPanel>
                </Button>
            </StackPanel>
        </StackPanel>

        <Grid Visibility="{Binding HasFiles, Converter={StaticResource BoolToVisibility}}">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="280" />
                <ColumnDefinition Width="16" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <DockPanel>
                <DockPanel DockPanel.Dock="Top" Margin="0,0,0,8">
                    <Button DockPanel.Dock="Right" Style="{StaticResource IconButton}" Command="{Binding OpenExternallyCommand}"
                            ToolTip="Otwórz w domyślnej przeglądarce" AutomationProperties.Name="Otwórz w domyślnej przeglądarce">
                        <TextBlock Text="&#xE8A7;" Style="{StaticResource IconText}" FontSize="14" />
                    </Button>
                    <Button DockPanel.Dock="Right" Style="{StaticResource IconButton}" Command="{Binding RefreshCommand}"
                            ToolTip="Szukaj ponownie" AutomationProperties.Name="Szukaj ponownie">
                        <TextBlock Text="&#xE72C;" Style="{StaticResource IconText}" FontSize="14" />
                    </Button>
                    <TextBlock Text="Quizy i fiszki" Style="{StaticResource SectionHeaderText}" Margin="0" VerticalAlignment="Center" />
                </DockPanel>
                <ListBox Style="{StaticResource PlainList}" ItemContainerStyle="{StaticResource ListRow}"
                         ItemsSource="{Binding Source={StaticResource FilesView}}" SelectedItem="{Binding Selected}"
                         AutomationProperties.Name="Quizy i fiszki">
                    <ListBox.GroupStyle>
                        <GroupStyle>
                            <GroupStyle.HeaderTemplate>
                                <DataTemplate>
                                    <TextBlock Text="{Binding Name}" Style="{StaticResource FieldLabelText}" Margin="10,10,0,4" />
                                </DataTemplate>
                            </GroupStyle.HeaderTemplate>
                        </GroupStyle>
                    </ListBox.GroupStyle>
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <StackPanel ToolTip="{Binding FullPath}">
                                <TextBlock Text="{Binding Title}" TextTrimming="CharacterEllipsis" />
                                <TextBlock x:Name="Detail" Text="{Binding Detail}" FontSize="12" Margin="0,2,0,0"
                                           Style="{StaticResource SecondaryText}" TextTrimming="CharacterEllipsis" />
                            </StackPanel>
                            <DataTemplate.Triggers>
                                <DataTrigger Binding="{Binding Detail}" Value="">
                                    <Setter TargetName="Detail" Property="Visibility" Value="Collapsed" />
                                </DataTrigger>
                            </DataTemplate.Triggers>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
            </DockPanel>

            <Border Grid.Column="2" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1"
                    Background="{StaticResource SurfaceBrush}">
                <Grid>
                    <wv2:WebView2 x:Name="WebView" />
                    <views:WebViewMissingPanel x:Name="RuntimeMissing" Visibility="Collapsed" />
                </Grid>
            </Border>
        </Grid>
    </Grid>
</UserControl>
