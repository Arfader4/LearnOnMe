<Window x:Class="LearnOnMe.App.Views.MessageDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Width="420" SizeToContent="Height" ResizeMode="NoResize" ShowInTaskbar="False"
        WindowStartupLocation="CenterOwner"
        Style="{StaticResource AppWindowStyle}">
    <StackPanel Margin="24,20,24,20">
        <TextBlock x:Name="MessageText" TextWrapping="Wrap" />
        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,24,0,0">
            <Button x:Name="CancelButton" Content="Anuluj" Style="{StaticResource SecondaryButton}"
                    IsCancel="True" Margin="0,0,8,0" />
            <Button x:Name="ConfirmButton" Style="{StaticResource PrimaryButton}" IsDefault="True"
                    Click="Confirm_Click" />
        </StackPanel>
    </StackPanel>
</Window>
