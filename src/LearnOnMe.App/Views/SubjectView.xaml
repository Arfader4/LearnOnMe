<UserControl x:Class="LearnOnMe.App.Views.SubjectView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:scm="clr-namespace:System.ComponentModel;assembly=WindowsBase"
             xmlns:models="clr-namespace:LearnOnMe.Core.Models;assembly=LearnOnMe.Core">
    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVisibility" />

        <CollectionViewSource x:Key="PinsView" Source="{Binding Pins}">
            <CollectionViewSource.GroupDescriptions>
                <PropertyGroupDescription PropertyName="GroupLabel" />
            </CollectionViewSource.GroupDescriptions>
            <CollectionViewSource.SortDescriptions>
                <scm:SortDescription PropertyName="Type" />
                <scm:SortDescription PropertyName="SortOrder" />
            </CollectionViewSource.SortDescriptions>
        </CollectionViewSource>

        <!-- Quick-add buttons in the empty state; Tag is the icon glyph. -->
        <Style x:Key="QuickAddButton" TargetType="Button" BasedOn="{StaticResource SecondaryButton}">
            <Setter Property="Margin" Value="0,0,8,0" />
            <Setter Property="Command" Value="{Binding AddPinCommand}" />
        </Style>
    </UserControl.Resources>

    <UserControl.InputBindings>
        <KeyBinding Key="Escape" Command="{Binding BackCommand}" />
        <KeyBinding Key="N" Modifiers="Control" Command="{Binding AddPinCommand}" />
    </UserControl.InputBindings>

    <!-- Transparent background so drops land anywhere on the card, not only on pins. -->
    <Grid Margin="24,20,16,0" Background="Transparent" AllowDrop="True"
          DragOver="Card_DragOver" Drop="Card_Drop">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <DockPanel Margin="0,0,16,0">
            <Button DockPanel.Dock="Right" Style="{StaticResource PrimaryButton}"
                    Command="{Binding AddPinCommand}" ToolTip="Dodaj przypinkę (Ctrl+N)"
                    VerticalAlignment="Center">
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="&#xE710;" Style="{StaticResource IconText}" FontSize="12" Margin="0,0,8,0" />
                    <TextBlock Text="Dodaj przypinkę" />
                </StackPanel>
            </Button>
            <StackPanel Orientation="Horizontal">
                <Button Style="{StaticResource GhostButton}" Command="{Binding BackCommand}"
                        ToolTip="Wróć do przedmiotów (Esc)" AutomationProperties.Name="Wróć do przedmiotów">
                    <TextBlock Text="&#xE72B;" Style="{StaticResource IconText}" />
                </Button>
                <Border Width="4" Height="28" Margin="12,0,12,0" CornerRadius="2"
                        Background="{Binding Tile.AccentBrush}" />
                <TextBlock Text="{Binding Tile.Name}" Style="{StaticResource PageTitleText}"
                           VerticalAlignment="Center" />
            </StackPanel>
        </DockPanel>

        <!-- Empty state -->
        <StackPanel Grid.Row="1" Margin="8,40,0,0" HorizontalAlignment="Left" MaxWidth="560">
            <StackPanel.Style>
                <Style TargetType="StackPanel">
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding HasPins}" Value="True">
                            <Setter Property="Visibility" Value="Collapsed" />
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </StackPanel.Style>
            <TextBlock Text="Przypnij to, czego używasz do tego przedmiotu" FontSize="18" FontWeight="SemiBold" />
            <TextBlock Margin="0,6,0,20" Style="{StaticResource SecondaryText}" TextWrapping="Wrap"
                       Text="Folder z notatkami, plik z wykładem, program do laborek albo link do Drive czy Teams. Możesz też przeciągnąć tu pliki i foldery z Eksploratora." />
            <StackPanel Orientation="Horizontal">
                <Button Style="{StaticResource QuickAddButton}" CommandParameter="{x:Static models:PinType.Folder}">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="&#xE8B7;" Style="{StaticResource IconText}" FontSize="14" Margin="0,0,8,0" />
                        <TextBlock Text="Dodaj folder" />
                    </StackPanel>
                </Button>
                <Button Style="{StaticResource QuickAddButton}" CommandParameter="{x:Static models:PinType.File}">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="&#xE8A5;" Style="{StaticResource IconText}" FontSize="14" Margin="0,0,8,0" />
                        <TextBlock Text="Dodaj plik" />
                    </StackPanel>
                </Button>
                <Button Style="{StaticResource QuickAddButton}" CommandParameter="{x:Static models:PinType.App}">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="&#xECAA;" Style="{StaticResource IconText}" FontSize="14" Margin="0,0,8,0" />
                        <TextBlock Text="Dodaj aplikację" />
                    </StackPanel>
                </Button>
                <Button Style="{StaticResource QuickAddButton}" CommandParameter="{x:Static models:PinType.Link}">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="&#xE71B;" Style="{StaticResource IconText}" FontSize="14" Margin="0,0,8,0" />
                        <TextBlock Text="Dodaj link" />
                    </StackPanel>
                </Button>
            </StackPanel>
        </StackPanel>

        <!-- Pins, grouped by type -->
        <ScrollViewer Grid.Row="1" Margin="8,24,0,0" VerticalScrollBarVisibility="Auto" Focusable="False"
                      Visibility="{Binding HasPins, Converter={StaticResource BoolToVisibility}}">
            <ItemsControl ItemsSource="{Binding Source={StaticResource PinsView}}" Focusable="False">
                <ItemsControl.GroupStyle>
                    <GroupStyle>
                        <GroupStyle.HeaderTemplate>
                            <DataTemplate>
                                <TextBlock Text="{Binding Name}" Style="{StaticResource SectionHeaderText}" />
                            </DataTemplate>
                        </GroupStyle.HeaderTemplate>
                    </GroupStyle>
                </ItemsControl.GroupStyle>
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <WrapPanel />
                    </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Grid x:Name="Root" Width="300" Height="64" Margin="0,0,12,12">
                            <Button Style="{StaticResource PinCardButton}"
                                    Command="{Binding DataContext.OpenPinCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                    CommandParameter="{Binding}"
                                    Tag="{Binding DataContext, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                    ToolTip="{Binding ToolTipText}"
                                    AutomationProperties.Name="{Binding Title}">
                                <Button.ContextMenu>
                                    <ContextMenu DataContext="{Binding PlacementTarget.Tag, RelativeSource={RelativeSource Self}}">
                                        <MenuItem Header="Otwórz" Command="{Binding OpenPinCommand}"
                                                  CommandParameter="{Binding PlacementTarget.DataContext, RelativeSource={RelativeSource AncestorType=ContextMenu}}" />
                                        <MenuItem Header="Edytuj" Command="{Binding EditPinCommand}"
                                                  CommandParameter="{Binding PlacementTarget.DataContext, RelativeSource={RelativeSource AncestorType=ContextMenu}}" />
                                        <MenuItem Header="Usuń" Command="{Binding DeletePinCommand}"
                                                  CommandParameter="{Binding PlacementTarget.DataContext, RelativeSource={RelativeSource AncestorType=ContextMenu}}" />
                                    </ContextMenu>
                                </Button.ContextMenu>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="32" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock x:Name="Icon" Text="{Binding Glyph}" Style="{StaticResource IconText}"
                                               FontSize="20" Foreground="{Binding DataContext.Tile.AccentBrush, RelativeSource={RelativeSource AncestorType=UserControl}}" />
                                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                        <TextBlock Text="{Binding Title}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                                        <TextBlock x:Name="TargetText" Text="{Binding Target}" FontSize="12" Margin="0,2,0,0"
                                                   Style="{StaticResource SecondaryText}" TextTrimming="CharacterEllipsis" />
                                    </StackPanel>
                                </Grid>
                            </Button>
                            <StackPanel x:Name="Actions" Orientation="Horizontal" Opacity="0"
                                        HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,8,0">
                                <Button Style="{StaticResource IconButton}"
                                        Command="{Binding DataContext.EditPinCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                        CommandParameter="{Binding}"
                                        ToolTip="Edytuj" AutomationProperties.Name="Edytuj przypinkę">
                                    <TextBlock Text="&#xE70F;" Style="{StaticResource IconText}" FontSize="14" />
                                </Button>
                                <Button Style="{StaticResource IconButton}"
                                        Command="{Binding DataContext.DeletePinCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                        CommandParameter="{Binding}"
                                        ToolTip="Usuń" AutomationProperties.Name="Usuń przypinkę">
                                    <TextBlock Text="&#xE74D;" Style="{StaticResource IconText}" FontSize="14" />
                                </Button>
                            </StackPanel>
                        </Grid>
                        <DataTemplate.Triggers>
                            <Trigger SourceName="Root" Property="IsMouseOver" Value="True">
                                <Setter TargetName="Actions" Property="Opacity" Value="1" />
                            </Trigger>
                            <Trigger SourceName="Root" Property="IsKeyboardFocusWithin" Value="True">
                                <Setter TargetName="Actions" Property="Opacity" Value="1" />
                            </Trigger>
                            <DataTrigger Binding="{Binding IsMissing}" Value="True">
                                <Setter TargetName="Icon" Property="Text" Value="&#xE7BA;" />
                                <Setter TargetName="Icon" Property="Foreground" Value="{StaticResource WarningBrush}" />
                                <Setter TargetName="TargetText" Property="Foreground" Value="{StaticResource WarningBrush}" />
                            </DataTrigger>
                        </DataTemplate.Triggers>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </ScrollViewer>
    </Grid>
</UserControl>
