<UserControl x:Class="LearnOnMe.App.Views.BrowserView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:views="clr-namespace:LearnOnMe.App.Views"
             xmlns:wv2="clr-namespace:Microsoft.Web.WebView2.Wpf;assembly=Microsoft.Web.WebView2.Wpf">
    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVisibility" />
    </UserControl.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <DockPanel Margin="0,0,0,10">
            <Button DockPanel.Dock="Right" Style="{StaticResource IconButton}" Command="{Binding OpenExternallyCommand}"
                    Margin="4,0,0,0" ToolTip="Otwórz w przeglądarce systemowej (np. gdy Google nie pozwala zalogować się tutaj)"
                    AutomationProperties.Name="Otwórz w przeglądarce systemowej">
                <TextBlock Text="&#xE8A7;" Style="{StaticResource IconText}" FontSize="14" />
            </Button>
            <Button DockPanel.Dock="Right" Style="{StaticResource SecondaryButton}" Command="{Binding PinPageCommand}"
                    Margin="8,0,0,0" ToolTip="Dodaj tę stronę do przypinek przedmiotu">
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="&#xE840;" Style="{StaticResource IconText}" FontSize="12" Margin="0,0,8,0" />
                    <TextBlock Text="Przypnij stronę" />
                </StackPanel>
            </Button>
            <Button Style="{StaticResource IconButton}" Click="Back_Click" IsEnabled="{Binding CanGoBack, ElementName=WebView}"
                    ToolTip="Wstecz (Alt+←)" AutomationProperties.Name="Wstecz">
                <TextBlock Text="&#xE72B;" Style="{StaticResource IconText}" FontSize="14" />
            </Button>
            <Button Style="{StaticResource IconButton}" Click="Forward_Click" IsEnabled="{Binding CanGoForward, ElementName=WebView}"
                    ToolTip="Dalej (Alt+→)" AutomationProperties.Name="Dalej">
                <TextBlock Text="&#xE72A;" Style="{StaticResource IconText}" FontSize="14" />
            </Button>
            <Button Style="{StaticResource IconButton}" Click="Reload_Click" Margin="0,0,8,0"
                    ToolTip="Odśwież (F5)" AutomationProperties.Name="Odśwież">
                <TextBlock Text="&#xE72C;" Style="{StaticResource IconText}" FontSize="14" />
            </Button>
            <TextBox x:Name="AddressBox" Text="{Binding Address, UpdateSourceTrigger=PropertyChanged}" VerticalContentAlignment="Center"
                     AutomationProperties.Name="Adres strony" GotKeyboardFocus="AddressBox_GotKeyboardFocus">
                <TextBox.InputBindings>
                    <KeyBinding Key="Enter" Command="{Binding GoCommand}" />
                </TextBox.InputBindings>
            </TextBox>
        </DockPanel>

        <Border Grid.Row="1" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1"
                Background="{StaticResource SurfaceBrush}">
            <Grid>
                <wv2:WebView2 x:Name="WebView" Visibility="{Binding HasPage, Converter={StaticResource BoolToVisibility}}" />

                <!-- Nothing opened yet -->
                <StackPanel Margin="24" MaxWidth="520" HorizontalAlignment="Left" VerticalAlignment="Top">
                    <StackPanel.Style>
                        <Style TargetType="StackPanel">
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding HasPage}" Value="True">
                                    <Setter Property="Visibility" Value="Collapsed" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </StackPanel.Style>
                    <TextBlock Text="Przeglądarka przedmiotu" FontSize="18" FontWeight="SemiBold" />
                    <TextBlock Margin="0,6,0,0" Style="{StaticResource SecondaryText}" TextWrapping="Wrap"
                               Text="Kliknij przypinkę z linkiem (Drive, Teams, Moodle) albo wpisz adres powyżej. Logowania zostają zapamiętane w LearnOnMe, więc następnym razem strona otworzy się od razu." />
                </StackPanel>

                <views:WebViewMissingPanel x:Name="RuntimeMissing" Visibility="Collapsed" />
            </Grid>
        </Border>
    </Grid>
</UserControl>
