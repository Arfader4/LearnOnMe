<Window x:Class="LearnOnMe.App.Views.PinEditorWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="{Binding WindowTitle}"
        Width="520" SizeToContent="Height" ResizeMode="NoResize" ShowInTaskbar="False"
        WindowStartupLocation="CenterOwner"
        Style="{StaticResource AppWindowStyle}">
    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVisibility" />
    </Window.Resources>

    <StackPanel Margin="24,20,24,20">
        <TextBlock Text="Rodzaj" Style="{StaticResource FieldLabelText}" />
        <Border Background="{StaticResource SurfaceBrush}" BorderBrush="{StaticResource BorderBrush}"
                BorderThickness="1" CornerRadius="7" Padding="3" HorizontalAlignment="Left">
            <StackPanel Orientation="Horizontal" KeyboardNavigation.DirectionalNavigation="Cycle">
                <RadioButton Style="{StaticResource SegmentRadio}" IsChecked="{Binding IsFolder}" GroupName="PinType">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="&#xE8B7;" Style="{StaticResource IconText}" FontSize="14" Margin="0,0,8,0" />
                        <TextBlock Text="Folder" />
                    </StackPanel>
                </RadioButton>
                <RadioButton Style="{StaticResource SegmentRadio}" IsChecked="{Binding IsFile}" GroupName="PinType">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="&#xE8A5;" Style="{StaticResource IconText}" FontSize="14" Margin="0,0,8,0" />
                        <TextBlock Text="Plik" />
                    </StackPanel>
                </RadioButton>
                <RadioButton Style="{StaticResource SegmentRadio}" IsChecked="{Binding IsApp}" GroupName="PinType">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="&#xECAA;" Style="{StaticResource IconText}" FontSize="14" Margin="0,0,8,0" />
                        <TextBlock Text="Aplikacja" />
                    </StackPanel>
                </RadioButton>
                <RadioButton Style="{StaticResource SegmentRadio}" IsChecked="{Binding IsLink}" GroupName="PinType">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="&#xE71B;" Style="{StaticResource IconText}" FontSize="14" Margin="0,0,8,0" />
                        <TextBlock Text="Link" />
                    </StackPanel>
                </RadioButton>
            </StackPanel>
        </Border>

        <Label Content="{Binding TargetLabel}" Target="{Binding ElementName=TargetBox}" Padding="0"
               Foreground="{StaticResource TextSecondaryBrush}" FontSize="13" Margin="0,20,0,6" />
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <TextBox x:Name="TargetBox" Text="{Binding Target, UpdateSourceTrigger=PropertyChanged}"
                     AutomationProperties.Name="{Binding TargetLabel}" />
            <Button Grid.Column="1" Content="Przeglądaj…" Style="{StaticResource SecondaryButton}"
                    Margin="8,0,0,0" Click="Browse_Click"
                    Visibility="{Binding CanBrowse, Converter={StaticResource BoolToVisibility}}" />
        </Grid>
        <TextBlock Text="{Binding TargetHint}" Style="{StaticResource SecondaryText}" FontSize="12"
                   TextWrapping="Wrap" Margin="0,6,0,0" />
        <TextBlock Text="{Binding TargetWarning}" Foreground="{StaticResource WarningBrush}" FontSize="12"
                   TextWrapping="Wrap" Margin="0,6,0,0">
            <TextBlock.Style>
                <Style TargetType="TextBlock">
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding TargetWarning}" Value="{x:Null}">
                            <Setter Property="Visibility" Value="Collapsed" />
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </TextBlock.Style>
        </TextBlock>

        <Label Content="Nazwa na karcie" Target="{Binding ElementName=TitleBox}" Padding="0"
               Foreground="{StaticResource TextSecondaryBrush}" FontSize="13" Margin="0,20,0,6" />
        <TextBox x:Name="TitleBox" Text="{Binding Title, UpdateSourceTrigger=PropertyChanged}"
                 AutomationProperties.Name="Nazwa na karcie" />

        <TextBlock Text="{Binding Error}" Foreground="{StaticResource DangerBrush}" TextWrapping="Wrap"
                   Margin="0,12,0,0">
            <TextBlock.Style>
                <Style TargetType="TextBlock">
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding Error}" Value="{x:Null}">
                            <Setter Property="Visibility" Value="Collapsed" />
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </TextBlock.Style>
        </TextBlock>

        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,24,0,0">
            <Button Content="Anuluj" Style="{StaticResource SecondaryButton}" IsCancel="True" Margin="0,0,8,0" />
            <Button Content="{Binding SaveLabel}" Style="{StaticResource PrimaryButton}" IsDefault="True"
                    Command="{Binding SaveCommand}" />
        </StackPanel>
    </StackPanel>
</Window>
