<UserControl x:Class="LearnOnMe.App.Views.HomeView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid Margin="32,28,16,0">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <StackPanel Margin="0,0,0,24">
            <TextBlock Text="Przedmioty" Style="{StaticResource PageTitleText}" />
            <TextBlock Text="Wybierz przedmiot, żeby otworzyć jego kartę." Margin="0,4,0,0"
                       Style="{StaticResource SecondaryText}" />
        </StackPanel>

        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" Focusable="False">
            <ItemsControl ItemsSource="{Binding Subjects}" Focusable="False">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <WrapPanel />
                    </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Button Style="{StaticResource SubjectTileButton}"
                                Command="{Binding DataContext.OpenSubjectCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                CommandParameter="{Binding}"
                                ToolTip="{Binding Name}"
                                AutomationProperties.Name="{Binding Name}">
                            <DockPanel LastChildFill="False">
                                <TextBlock DockPanel.Dock="Top" Text="{Binding Code}"
                                           FontSize="13" FontWeight="SemiBold"
                                           Foreground="{Binding AccentBrush}" />
                                <TextBlock DockPanel.Dock="Bottom" Text="{Binding Name}"
                                           FontSize="18" FontWeight="SemiBold"
                                           TextWrapping="Wrap" TextTrimming="CharacterEllipsis" />
                            </DockPanel>
                        </Button>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </ScrollViewer>
    </Grid>
</UserControl>
