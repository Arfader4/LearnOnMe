<UserControl x:Class="LearnOnMe.App.Views.FolderPreviewView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVisibility" />
    </UserControl.Resources>
    <UserControl.InputBindings>
        <KeyBinding Key="Back" Command="{Binding UpCommand}" />
        <KeyBinding Key="Escape" Command="{Binding CloseCommand}" />
    </UserControl.InputBindings>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <DockPanel>
            <Button DockPanel.Dock="Right" Style="{StaticResource SecondaryButton}" Command="{Binding OpenInExplorerCommand}"
                    ToolTip="{Binding CurrentPath}">
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="&#xE8A7;" Style="{StaticResource IconText}" FontSize="12" Margin="0,0,8,0" />
                    <TextBlock Text="Otwórz w Eksploratorze" />
                </StackPanel>
            </Button>
            <Button Style="{StaticResource IconButton}" Command="{Binding CloseCommand}"
                    ToolTip="Wróć do przypinek (Esc)" AutomationProperties.Name="Wróć do przypinek">
                <TextBlock Text="&#xE72B;" Style="{StaticResource IconText}" FontSize="14" />
            </Button>
            <Button Style="{StaticResource IconButton}" Command="{Binding UpCommand}" Margin="4,0,0,0"
                    ToolTip="Folder wyżej (Backspace)" AutomationProperties.Name="Folder wyżej"
                    Visibility="{Binding CanGoUp, Converter={StaticResource BoolToVisibility}}">
                <TextBlock Text="&#xE74A;" Style="{StaticResource IconText}" FontSize="14" />
            </Button>
            <TextBlock Text="&#xE8B7;" Style="{StaticResource IconText}" Margin="12,0,8,0"
                       Foreground="{StaticResource TextSecondaryBrush}" />
            <TextBlock Text="{Binding Breadcrumb}" FontSize="16" FontWeight="SemiBold" VerticalAlignment="Center"
                       TextTrimming="CharacterEllipsis" ToolTip="{Binding CurrentPath}" />
        </DockPanel>

        <!-- Column headers -->
        <Grid Grid.Row="1" Margin="11,16,11,6">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="28" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="140" />
                <ColumnDefinition Width="90" />
            </Grid.ColumnDefinitions>
            <TextBlock Grid.Column="1" Text="Nazwa" Style="{StaticResource FieldLabelText}" Margin="0" />
            <TextBlock Grid.Column="2" Text="Zmodyfikowano" Style="{StaticResource FieldLabelText}" Margin="0" />
            <TextBlock Grid.Column="3" Text="Rozmiar" Style="{StaticResource FieldLabelText}" Margin="0" HorizontalAlignment="Right" />
        </Grid>

        <ListBox x:Name="EntryList" Grid.Row="2" Style="{StaticResource PlainList}" ItemsSource="{Binding Entries}"
                 AutomationProperties.Name="Pliki w folderze">
            <ListBox.InputBindings>
                <KeyBinding Key="Enter" Command="{Binding OpenCommand}"
                            CommandParameter="{Binding SelectedItem, ElementName=EntryList}" />
            </ListBox.InputBindings>
            <ListBox.ItemContainerStyle>
                <Style TargetType="ListBoxItem" BasedOn="{StaticResource ListRow}">
                    <EventSetter Event="MouseDoubleClick" Handler="Entry_DoubleClick" />
                </Style>
            </ListBox.ItemContainerStyle>
            <ListBox.ItemTemplate>
                <DataTemplate>
                    <Grid ToolTip="{Binding ToolTipText}">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="28" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="140" />
                            <ColumnDefinition Width="90" />
                        </Grid.ColumnDefinitions>
                        <TextBlock x:Name="Icon" Text="{Binding Glyph}" Style="{StaticResource IconText}"
                                   Foreground="{StaticResource TextSecondaryBrush}" />
                        <TextBlock Grid.Column="1" Text="{Binding Name}" TextTrimming="CharacterEllipsis" VerticalAlignment="Center" />
                        <TextBlock Grid.Column="2" Text="{Binding ModifiedText}" Style="{StaticResource SecondaryText}"
                                   FontSize="12" VerticalAlignment="Center" />
                        <TextBlock Grid.Column="3" Text="{Binding SizeText}" Style="{StaticResource SecondaryText}"
                                   FontSize="12" VerticalAlignment="Center" HorizontalAlignment="Right" />
                    </Grid>
                    <DataTemplate.Triggers>
                        <DataTrigger Binding="{Binding IsDirectory}" Value="True">
                            <Setter TargetName="Icon" Property="Foreground" Value="{StaticResource WarningBrush}" />
                        </DataTrigger>
                    </DataTemplate.Triggers>
                </DataTemplate>
            </ListBox.ItemTemplate>
        </ListBox>

        <!-- Empty folder or error -->
        <TextBlock Grid.Row="2" Margin="11,8,0,0" Style="{StaticResource SecondaryText}" Text="Ten folder jest pusty."
                   Visibility="{Binding IsEmpty, Converter={StaticResource BoolToVisibility}}" />
        <TextBlock Grid.Row="2" Margin="11,8,0,0" Foreground="{StaticResource WarningBrush}" TextWrapping="Wrap"
                   Text="{Binding Error}">
            <TextBlock.Style>
                <Style TargetType="TextBlock">
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding Error}" Value="{x:Null}">
                            <Setter Property="Visibility" Value="Collapsed" />
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </TextBlock.Style>
        </TextBlock>
    </Grid>
</UserControl>
