<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <AssemblyName>LearnOnMe</AssemblyName>
    <RootNamespace>LearnOnMe.App</RootNamespace>
    <!-- Lets the solution build on non-Windows machines (e.g. CI); running still needs Windows. -->
    <EnableWindowsTargeting>true</EnableWindowsTargeting>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="..\LearnOnMe.Core\LearnOnMe.Core.csproj" />
    <ProjectReference Include="..\LearnOnMe.Data\LearnOnMe.Data.csproj" />
  </ItemGroup>
</Project>
